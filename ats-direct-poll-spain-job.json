        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: \"openclaw\",\n  messages: [\n    {\n      role: \"user\",\n      content: \"Вакансия прошла отбор для человека, который ищет удалённую работу в Испании через ИИ-инструменты (без сертификатов и глубокой технической экспертизы).\\n\\nTitle: \" + $json.title + \"\\nCompany: \" + $json.company_slug + \"\\nURL: \" + $json.url + \"\\n\\nЗадача: найди в интернете контакт нанимающего менеджера или рекрутера в этой компании (LinkedIn, email по паттерну домена, или страница команды), собери короткий контекст о компании/продукте, и подготовь черновик персонализированного письма на русском для отклика на эту вакансию. Не отправляй письмо, только верни готовый черновик текстом, без markdown-разметки.\"\n    }\n  ]\n}) }}",
