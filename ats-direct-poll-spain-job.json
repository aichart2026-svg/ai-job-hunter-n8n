      "id": "10cbcb7d-7038-4154-b8c4-eb51d5e7ecd1",
      "name": "DeepSeek Score Job",
      "credentials": {
        "deepSeekApi": {
          "name": "YOUR_CREDENTIAL"
        }
      },
      "continueOnFail": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "const raw = $input.item.json;\nconst itemIndex = $itemIndex;\n\nlet ai;\ntry {\n  const txt = raw.choices?.[0]?.message?.content || '{}';\n  ai = JSON.parse(txt.replace(/```json|```/g, '').trim());\n} catch(e) {\n  console.log('Failed to parse DeepSeek response:', e.message);\n  ai = { task_simplicity: 0, entry_barrier_risk: 0, spain_remote_fit: 0, reasoning: 'Ошибка оценки' };\n}\n\nlet job;\ntry {\n  job = $('Reset Item Pairing').itemMatching(itemIndex).json;\n} catch(e) {\n  const all = $('Reset Item Pairing').all();\n  job = all[itemIndex] ? all[itemIndex].json : {};\n}\n\nreturn { json: {\n  job_id: job.job_id,\n  company_slug: job.company_slug,\n  title: job.title,\n  url: job.url,\n  task_simplicity: parseInt(ai.task_simplicity) || 0,\n  entry_barrier_risk: parseInt(ai.entry_barrier_risk) || 0,\n  spain_remote_fit: parseInt(ai.spain_remote_fit) || 0,\n  reason_ru: ai.reasoning || ''\n} };"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
